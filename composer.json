{
    "name": "tooinfinity/package-skeleton-php",
    "description": "A skeleton repository for my packages",
    "keywords": ["php", "skeleton", "package"],
    "license": "MIT",
    "authors": [
        {
            "name": "TouwfiQ Meghlaoui",
            "email": "touwfiqdev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32.1",
        "peckphp/peck": "^0.1.3",
        "pestphp/pest": "^5.2.1",
        "pestphp/pest-plugin-phpstan": "^5.2.1",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "phpstan/phpstan": "^2.2.14",
        "rector/rector": "^2.6.7",
        "symfony/var-dumper": "^8.1.7"
    },
    "autoload": {
        "psr-4": {
            "TooInfinity\\PackageSkeletonPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "rector": "rector",
        "lint": "pint",
        "test:rector": "rector --dry-run",
        "test:lint": "pint --test",
        "test:typos": "peck",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:rector",
            "@test:lint",
            "@test:typos",
            "@test:types",
            "@test:unit"
        ]
    }
}
